[MAIN]

# Let pylint resolve imports of the example modules used by the Modules lessons.
init-hook='import sys; sys.path.append("./src/modules")'

[MESSAGES CONTROL]

# The lessons deliberately show older or simpler forms of code next to the recommended ones
# (str.format(), "pass" placeholders, dict() calls, comparisons with empty collections), so the
# checks that would flag those teaching examples are turned off.
disable=consider-using-f-string,
        unnecessary-pass,
        use-dict-literal,
        use-implicit-booleaness-not-comparison,
        implicit-str-concat,
        no-else-break

[FORMAT]

max-line-length=100
ignore-long-lines=^\s*(# )?<?https?://\S+>?$

[BASIC]

good-names=i,
           j,
           k,
           x,
           y,
           ex,
           _
